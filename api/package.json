{
  "name": "maluporai-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "test": "npm run test:db:migrate && node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "node scripts/run-with-migration-url.mjs migrate dev",
    "db:migrate:deploy": "node scripts/run-with-migration-url.mjs migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test:db:migrate": "ENV_FILE=.env.test node scripts/run-with-migration-url.mjs migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/supertest": "^7.2.1"
  }
}
